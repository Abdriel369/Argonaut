IP_LAPTOP2=192.168.50.12
PUERTO_GATEWAY=8200            # la Laptop 3 llama a http://IP_LAPTOP2:8200
TIEMPO_MAX_MODELO_S=3          # tiempo máximo de espera por modelo en el gateway
USAR_GPU=auto                  # auto: usa NVIDIA si existe; no: fuerza CPU
