# ---------------------------------------------------------------------------
# LAPTOP 1 · variables. Copiar a .env y ajustar las IP reales del router.
# Las IP fijas del router propio: nada se escribe a mano en el código.
# ---------------------------------------------------------------------------
IP_LAPTOP1=192.168.50.11
IP_LAPTOP2=192.168.50.12
IP_LAPTOP3=192.168.50.13

PUERTO_BACKEND=8100            # interfaz web: http://IP_LAPTOP1:8100 (celular o laptop)
PUERTO_ORQUESTADOR=8300        # Laptop 3
TIEMPO_MAX_ORQUESTADOR_S=8     # espera máxima por el orquestador antes de reintentar
REINTENTOS_ORQUESTADOR=2       # si fallan todos, se evalúa con el respaldo local
NIVEL_LOG=INFO
