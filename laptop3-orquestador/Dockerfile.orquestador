# Laptop 3 · orquestador (reglas, enrutamiento, síntesis). Sin modelos pesados.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY laptop3-orquestador/requirements-orquestador.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY comun /app/comun
COPY contratos /app/contratos
COPY laptop3-orquestador/orquestador /app/laptop3-orquestador/orquestador
COPY laptop3-orquestador/reglas /app/laptop3-orquestador/reglas
COPY laptop3-orquestador/protocolos /app/laptop3-orquestador/protocolos
ENV PYTHONPATH=/app:/app/laptop3-orquestador
WORKDIR /app/laptop3-orquestador
EXPOSE 8300
CMD ["uvicorn", "orquestador.principal:crear_app", "--factory", "--host", "0.0.0.0", "--port", "8300"]
